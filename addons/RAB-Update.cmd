@echo off
title RAB Addon Updater
echo ================================================================
echo   RAB Addon Updater - finds every Minecraft data folder the
echo   launcher actually uses, clears old RAB builds, installs the
echo   newest one. Close Minecraft first.
echo ================================================================
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$uuids=@('efb65a54-925f-4010-81df-94f716666141','f293a3f3-67f8-44ba-ac2f-faa727532237'); $mc=Get-Process -Name 'Minecraft.Windows' -ErrorAction SilentlyContinue; if($mc){ Write-Host '  Minecraft is RUNNING. Close it completely, then run this again.'; exit 1 }; $roots=@(); foreach($l in @(\"$env:LocalAppData\Packages\Microsoft.MinecraftUWP_8wekyb3d8bbwe\LocalState\games\com.mojang\",\"$env:LocalAppData\Packages\Microsoft.MinecraftWindowsBeta_8wekyb3d8bbwe\LocalState\games\com.mojang\",\"$env:LocalAppData\games\com.mojang\")){ if(Test-Path $l){ $roots += $l } }; $lb=Join-Path $env:AppData 'Minecraft Bedrock\Users'; if(Test-Path $lb){ Get-ChildItem $lb -Directory -ErrorAction SilentlyContinue | ForEach-Object { $p=Join-Path $_.FullName 'games\com.mojang'; if(Test-Path $p){ $roots += $p } } }; $roots=@($roots | Select-Object -Unique); if(-not $roots.Count){ Write-Host '  FAILED: no Minecraft data folder found'; exit 1 }; Write-Host '  Data folders found:'; foreach($r in $roots){ Write-Host ('    ' + $r) }; Write-Host ''; $targets=@(); foreach($r in $roots){ foreach($kind in @('behavior_packs','development_behavior_packs')){ $dir=Join-Path $r $kind; if(-not (Test-Path $dir)){ continue }; Get-ChildItem $dir -Directory -ErrorAction SilentlyContinue | ForEach-Object { $mf=Join-Path $_.FullName 'manifest.json'; if(Test-Path $mf){ try { $old=Get-Content $mf -Raw | ConvertFrom-Json; if($uuids -contains $old.header.uuid){ Remove-Item $_.FullName -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ('  removed old copy: ' + $_.Name + '  (' + $kind + ', v' + ($old.header.version -join '.') + ')'); $script:targets += $r } } catch {} } } } }; $targets=@($targets | Select-Object -Unique); if(-not $targets.Count){ $shared=$roots | Where-Object { $_ -like '*\Shared\*' } | Select-Object -First 1; if($shared){ $targets=@($shared) } else { $targets=@($roots[0]) }; Write-Host ('  no old copies found - installing into ' + $targets[0]) }; $ok=0; foreach($t in $targets){ $bp=Join-Path $t 'behavior_packs'; try { $z=Join-Path $env:TEMP ('rab-'+[IO.Path]::GetRandomFileName()+'.zip'); Invoke-WebRequest -Uri 'https://sherowhayden-maker.github.io/addons/RAB-Scoreboard.mcpack' -OutFile $z -UseBasicParsing; $x=Join-Path $env:TEMP ('rab-x-'+[IO.Path]::GetRandomFileName()); Expand-Archive -LiteralPath $z -DestinationPath $x -Force; if(-not (Test-Path (Join-Path $x 'manifest.json'))){ throw 'bad download - manifest missing' }; New-Item -ItemType Directory -Force -Path $bp | Out-Null; $dest=Join-Path $bp 'RAB-Scoreboard'; if(Test-Path $dest){ Remove-Item $dest -Recurse -Force }; New-Item -ItemType Directory -Force -Path $dest | Out-Null; Copy-Item (Join-Path $x '*') $dest -Recurse -Force; $m=Get-Content (Join-Path $x 'manifest.json') -Raw | ConvertFrom-Json; Write-Host ('  OK - installed ' + $m.header.name + ' v' + ($m.header.version -join '.') + '  ->  ' + $dest); $ok++; Remove-Item $x -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item $z -Force -ErrorAction SilentlyContinue } catch { Write-Host ('  FAILED in ' + $t + ': ' + $_.Exception.Message); exit 1 } }; if(-not $ok){ Write-Host '  FAILED: nothing installed'; exit 1 }; Write-Host ''; Write-Host '  DONE. Start Minecraft. If the pack shows as missing in'; Write-Host '  Edit World, activate RAB Scoreboard v2 once, then Play.'"
echo.
pause
