@echo off
title RAB Addon Updater
echo ================================================================
echo   RAB Addon Updater - pulls the newest build and installs it.
echo   Close Minecraft first. Run this anytime for updates.
echo ================================================================
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$uuid='f293a3f3-67f8-44ba-ac2f-faa727532237'; $mc=Get-Process -Name 'Minecraft.Windows' -ErrorAction SilentlyContinue; if($mc){ Write-Host '  Minecraft is RUNNING. Close it completely, then run this again.'; exit 1 }; $roots=@(\"$env:LocalAppData\Packages\Microsoft.MinecraftUWP_8wekyb3d8bbwe\LocalState\games\com.mojang\",\"$env:LocalAppData\Packages\Microsoft.MinecraftWindowsBeta_8wekyb3d8bbwe\LocalState\games\com.mojang\",\"$env:LocalAppData\games\com.mojang\"); $live=@(); foreach($r in $roots){ if(Test-Path $r){ $live+=$r } }; if(-not $live.Count){ Write-Host '  FAILED: could not find Minecraft data folder (is Bedrock installed on this PC?)'; exit 1 }; foreach($r in $live){ foreach($kind in @('behavior_packs','development_behavior_packs')){ $dir=Join-Path $r $kind; if(-not (Test-Path $dir)){ continue }; Get-ChildItem $dir -Directory -ErrorAction SilentlyContinue | ForEach-Object { $mf=Join-Path $_.FullName 'manifest.json'; if(Test-Path $mf){ try { $old=Get-Content $mf -Raw | ConvertFrom-Json; if($old.header.uuid -eq $uuid){ Remove-Item $_.FullName -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ('  removed old copy: ' + $_.Name + '  (' + $kind + ')') } } catch {} } } } }; $ok=0; foreach($r in $live){ $bp=Join-Path $r 'behavior_packs'; try { $z=Join-Path $env:TEMP ('rab-'+[IO.Path]::GetRandomFileName()+'.zip'); Invoke-WebRequest -Uri 'https://sherowhayden-maker.github.io/addons/RAB-Scoreboard.mcpack' -OutFile $z -UseBasicParsing; $x=Join-Path $env:TEMP ('rab-x-'+[IO.Path]::GetRandomFileName()); Expand-Archive -LiteralPath $z -DestinationPath $x -Force; if(-not (Test-Path (Join-Path $x 'manifest.json'))){ throw 'bad download - manifest missing' }; New-Item -ItemType Directory -Force -Path $bp | Out-Null; $dest=Join-Path $bp 'RAB-Scoreboard'; if(Test-Path $dest){ Remove-Item $dest -Recurse -Force }; New-Item -ItemType Directory -Force -Path $dest | Out-Null; Copy-Item (Join-Path $x '*') $dest -Recurse -Force; $m=Get-Content (Join-Path $x 'manifest.json') -Raw | ConvertFrom-Json; Write-Host ('  OK - installed ' + $m.header.name + ' v' + ($m.header.version -join '.') + '  [' + $r + ']'); $ok++; Remove-Item $x -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item $z -Force -ErrorAction SilentlyContinue } catch { Write-Host ('  FAILED in ' + $r + ': ' + $_.Exception.Message); exit 1 } }; if(-not $ok){ Write-Host '  FAILED: nothing installed'; exit 1 }; Write-Host ''; Write-Host '  Done. Start Minecraft and load your world.'; Write-Host '  If the pack shows as missing in Edit World, activate it once.'"
echo.
pause
