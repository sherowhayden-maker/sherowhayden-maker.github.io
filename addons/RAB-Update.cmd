@echo off
setlocal
title RAB Addon Updater
echo ================================================================
echo   RAB Addon Updater
echo   This file carries RAB Scoreboard v2 build 3.60.0 and the
echo   RAB Personal HUD pack build 1.2.0 inside it.
echo   Double-click and it installs both into every Minecraft data
echo   folder on this PC, then keeps your worlds bound to them.
echo   No download, nothing else to copy.
echo.
echo   Drag a .mcpack onto this file to install a different build.
echo.
echo   Not sure what is installed, or the realm looks unchanged?
echo   Run this file as:  RAB-Update.cmd /report
echo   It changes nothing and prints the build in every folder, the
echo   build each world is bound to, and the Realm re-apply steps.
echo ================================================================
echo.
set "RAB_SELF=%~f0"
set "RAB_RUN_DIR=%~dp0"
set "RAB_REPORT="
if /i "%~1"=="/report" set "RAB_REPORT=-Report"
if /i "%~1"=="-report" set "RAB_REPORT=-Report"
if /i "%~1"=="report" set "RAB_REPORT=-Report"
set "RAB_PACK_ARG=%~1"
if defined RAB_REPORT set "RAB_PACK_ARG="
set "RAB_TMP=%TEMP%\rab-update-run.ps1"
set "RAB_PACK=%TEMP%\rab-update-pack.mcpack"
set "RAB_HUD_PACK=%TEMP%\rab-update-hud.mcpack"
set "RAB_HUD_PATH=%RAB_HUD_PACK%"
if not defined RAB_PACK_ARG set "RAB_PACK_ARG=%RAB_PACK%"
if exist "%RAB_TMP%" del "%RAB_TMP%" >nul 2>&1
if exist "%RAB_PACK%" del "%RAB_PACK%" >nul 2>&1
if exist "%RAB_HUD_PACK%" del "%RAB_HUD_PACK%" >nul 2>&1
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $L=Get-Content -LiteralPath $env:RAB_SELF; $b=[Array]::IndexOf($L,'#@@RAB_PS_BODY@@'); $p=[Array]::IndexOf($L,'#@@RAB_PACK@@'); $e=[Array]::IndexOf($L,'#@@RAB_PACK_END@@'); if ($b -lt 0 -or $p -le $b -or $e -le $p) { throw 'this file is damaged or truncated - download RAB-Update.cmd again' }; $body=($L[($b+1)..($p-1)] -join ([char]13+[char]10)); [IO.File]::WriteAllText($env:RAB_TMP,$body,(New-Object Text.UTF8Encoding($false))); $s=($L[($p+1)..($e-1)] -join ''); [IO.File]::WriteAllBytes($env:RAB_PACK,[Convert]::FromBase64String($s)); $h=[Array]::IndexOf($L,'#@@RAB_HUD_PACK@@'); $he=[Array]::IndexOf($L,'#@@RAB_HUD_PACK_END@@'); if ($h -ge 0 -and $he -gt $h) { $hs=($L[($h+1)..($he-1)]) -join ''; [IO.File]::WriteAllBytes($env:RAB_HUD_PACK,[Convert]::FromBase64String($hs)) } } catch { Write-Host ('  FAILED: ' + $_.Exception.Message); exit 1 }"
if errorlevel 1 goto :fail
powershell -NoProfile -ExecutionPolicy Bypass -File "%RAB_TMP%" %RAB_REPORT%
set "RAB_CODE=%ERRORLEVEL%"
if exist "%RAB_TMP%" del "%RAB_TMP%" >nul 2>&1
if exist "%RAB_PACK%" del "%RAB_PACK%" >nul 2>&1
if exist "%RAB_HUD_PACK%" del "%RAB_HUD_PACK%" >nul 2>&1
echo.
if not "%RAB_CODE%"=="0" echo   Stopped with an error - the reason is above.
echo.
pause
exit /b %RAB_CODE%
:fail
echo.
pause
exit /b 1
#@@RAB_PS_BODY@@
# RAB Addon Updater (logic)
#
# Installs the newest RAB Scoreboard build into every Minecraft data folder
# this PC uses, then keeps existing worlds bound to it so nothing has to be
# re-activated in Edit World.
#
# "Newest" is checked against the site, not just against the copy this file
# carries: when site/addons/version.json names a newer build, that pack is
# downloaded and installed instead. A months-old download therefore still puts
# the current build on the PC, which is the whole point of an updater.
#
# Normally you do not run this file directly - double-click RAB-Update.cmd,
# which carries this script inside itself. You can also drag a .mcpack (or a
# folder that contains one) onto that .cmd.
#
# Options (for manual runs):
#   -PackPath <file|folder>   use this .mcpack instead of searching
#   -RunDir   <folder>        folder the .cmd lives in (set automatically)
#   -DataRoot <folder>        force one specific ...\com.mojang folder
#   -Force                    continue even if Minecraft is running
#   -NoUpdateCheck            install the copy this file carries, without asking the site
#   -Report                   print what is installed and what each world is bound to
#
# The .cmd hands the dragged file / the embedded pack over through the
# RAB_PACK_ARG and RAB_RUN_DIR environment variables, so no path ever has to
# survive batch quoting (a trailing backslash used to break that).

param(
  [string]$PackPath,
  [string]$HudPath,
  [string]$RunDir,
  [string]$DataRoot,
  [switch]$Force,
  [switch]$Report,
  [switch]$NoUpdateCheck
)

$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"

if (-not $PackPath -and $env:RAB_PACK_ARG) { $PackPath = $env:RAB_PACK_ARG }
if (-not $HudPath -and $env:RAB_HUD_PATH) { $HudPath = $env:RAB_HUD_PATH }
if (-not $RunDir -and $env:RAB_RUN_DIR) { $RunDir = $env:RAB_RUN_DIR }

# a dragged folder arrives as C:\some\folder\ - drop the trailing slash
if ($PackPath) { $PackPath = $PackPath.TrimEnd("\") }
if ($RunDir) { $RunDir = $RunDir.TrimEnd("\") }

$packUuids  = @("efb65a54-925f-4010-81df-94f716666141", "f293a3f3-67f8-44ba-ac2f-faa727532237")
$packFolder = "RAB-Scoreboard"
$packUrl    = "https://sherowhayden-maker.github.io/addons/RAB-Scoreboard.mcpack"

# The HUD resource pack (addons\rab-hud-rp). It is embedded in the one-file
# updater alongside the scoreboard and unpacked to %TEMP%, so running the updater
# installs both - there is no second file to remember. When it is there, every
# world that already runs the scoreboard gets it applied too: importing a
# resource pack into Minecraft does nothing on its own, and forgetting that step
# looks exactly like the pack being broken. The embedded copy is used first;
# a loose RAB-HUD.mcpack beside the .cmd is only a fallback for hand runs of
# this .ps1, where nothing has been unpacked.
$hudUuids   = @("04be9756-7719-46a7-9829-7af232c88ef3")
$hudFolder  = "RAB-Personal-HUD"
$tempWork   = New-Object System.Collections.Generic.List[string]

function Say([string]$text) { Write-Host $text }

function Clear-Temp {
  foreach ($p in $tempWork) {
    Remove-Item -LiteralPath $p -Recurse -Force -ErrorAction SilentlyContinue
  }
  $tempWork.Clear()
}

function Stop-Fail([string]$text) {
  Write-Host ("  FAILED: " + $text)
  Clear-Temp
  exit 1
}

# The site's build number, or $null when it cannot be read (offline, DNS blocked,
# a captive portal). Never throws: the updater has to work with no network too.
function Get-SiteVersion {
  try {
    $verUrl = $packUrl -replace "RAB-Scoreboard\.mcpack$", "version.json"
    $resp = Invoke-WebRequest -Uri ($verUrl + "?t=" + [DateTime]::UtcNow.Ticks) -UseBasicParsing -TimeoutSec 8
    $txt = $resp.Content
    # Windows PowerShell hands back a byte[] when the server does not send a text
    # content type, and a byte[] has no TrimStart - which silently turned the old
    # check off altogether.
    if ($txt -is [byte[]]) { $txt = [Text.Encoding]::UTF8.GetString($txt) }
    if (-not $txt) { return $null }
    return ((($txt.TrimStart([char]0xFEFF)) | ConvertFrom-Json).version -join ".")
  } catch { return $null }
}

# True when $a is a newer build number than $b.
function Test-NewerVersion([string]$a, [string]$b) {
  $va = $null
  $vb = $null
  if ([version]::TryParse([string]$a, [ref]$va) -and [version]::TryParse([string]$b, [ref]$vb)) {
    return ($va -gt $vb)
  }
  return ($a -and $a -ne $b)
}

function Expand-PackFile([string]$file) {
  $work = Join-Path $env:TEMP ("rab-x-" + [IO.Path]::GetRandomFileName())
  New-Item -ItemType Directory -Force -Path $work | Out-Null
  # Expand-Archive refuses anything that is not *.zip, and a pack is *.mcpack,
  # so unzip through .NET instead - it only cares about the bytes.
  Add-Type -AssemblyName System.IO.Compression.FileSystem
  try {
    [System.IO.Compression.ZipFile]::ExtractToDirectory($file, $work)
  } catch {
    Remove-Item $work -Recurse -Force -ErrorAction SilentlyContinue
    throw ((Split-Path $file -Leaf) + " is not a Minecraft pack - a .mcpack or .zip was expected")
  }
  if (Test-Path (Join-Path $work "manifest.json")) { return $work }
  $inner = Get-ChildItem $work -Directory -ErrorAction SilentlyContinue |
    Where-Object { Test-Path (Join-Path $_.FullName "manifest.json") } |
    Select-Object -First 1
  if ($inner) { return $inner.FullName }
  Remove-Item $work -Recurse -Force -ErrorAction SilentlyContinue
  throw ((Split-Path $file -Leaf) + " is not a Minecraft pack - no manifest.json at its root")
}

# ---------------------------------------------------------------- 1. Minecraft
Say "  [1/5] Checking Minecraft"
if ($Report) {
  Say "        skipped (report only - nothing is changed)"
} elseif ($Force) {
  Say "        skipped (-Force)"
} else {
  # Any Minecraft client, not just the Store one: the unofficial launcher runs
  # Minecraft.exe, and a game left open silently rewrites the world's pack list
  # on exit - the pack installs, then disappears from the world, which looks
  # exactly like a broken pack.
  function Get-MinecraftClient {
    @(Get-Process -ErrorAction SilentlyContinue |
      Where-Object { $_.ProcessName -like "*Minecraft*" -and $_.ProcessName -notlike "*Server*" })
  }

  if (@(Get-MinecraftClient).Count -gt 0) {
    Say "        Minecraft is open - close it completely, it locks the pack files."
    Say "        Waiting up to 60s for it to close..."
    $waited = 0
    while ($waited -lt 60 -and @(Get-MinecraftClient).Count -gt 0) {
      Start-Sleep -Seconds 1
      $waited++
      if ($waited % 10 -eq 0) { Say ("        still open (" + $waited + "s)") }
    }
    if (@(Get-MinecraftClient).Count -gt 0) {
      Stop-Fail "Minecraft is still open. Close it, then run this again."
    }
    Say "        Minecraft closed - continuing."
  } else {
    Say "        closed"
  }
}

# ------------------------------------------------------------ 2. Data folders
Say "  [2/5] Looking for Minecraft data folders"
$known = @()
if ($DataRoot) { $known += $DataRoot }
$pkgRoot = Join-Path $env:LocalAppData "Packages"
$known += @(
  (Join-Path $pkgRoot "Microsoft.MinecraftUWP_8wekyb3d8bbwe\LocalState\games\com.mojang"),
  (Join-Path $pkgRoot "Microsoft.MinecraftWindowsBeta_8wekyb3d8bbwe\LocalState\games\com.mojang"),
  (Join-Path $env:LocalAppData "games\com.mojang")
)
if (Test-Path $pkgRoot) {
  foreach ($pkg in (Get-ChildItem $pkgRoot -Directory -ErrorAction SilentlyContinue |
                    Where-Object { $_.Name -like "Microsoft.Minecraft*" })) {
    $known += (Join-Path $pkg.FullName "LocalState\games\com.mojang")
  }
}
$launcher = Join-Path $env:AppData "Minecraft Bedrock\Users"
if (Test-Path $launcher) {
  foreach ($u in (Get-ChildItem $launcher -Directory -ErrorAction SilentlyContinue)) {
    $known += (Join-Path $u.FullName "games\com.mojang")
  }
}

# The same folder turns up twice on some PCs: once from the Packages scan (short
# 8.3 path) and once from the known list (long path). Installing twice is
# harmless but "2 worlds skipped" for 1 world is not, so de-duplicate on the
# trailing path segments instead of the raw string.
function Get-RootKey([string]$p) {
  $parts = @($p -split '\\' | Where-Object { $_ })
  $take = [Math]::Min(4, $parts.Count)
  return (($parts[($parts.Count - $take)..($parts.Count - 1)]) -join '\').ToLower()
}

$roots = @()
$seenRoots = @{}
foreach ($c in $known) {
  if (-not $c -or -not (Test-Path $c)) { continue }
  $key = Get-RootKey $c
  if ($seenRoots.ContainsKey($key)) { continue }
  $seenRoots[$key] = $true
  $roots += $c
}
if ($roots.Count -eq 0) { Stop-Fail "no Minecraft data folder found - is Bedrock installed on this PC?" }
foreach ($r in $roots) { Say ("        " + $r) }

# ------------------------------------------------------------- report mode
# Reads and reports. No install, no re-bind, no deletes: the answer to "which
# build is the realm actually running, and why does nothing I do show up?"
if ($Report) {
  Say ""
  Say "  RAB REPORT - what is on this PC, and what each world is bound to"
  Say "  (nothing is changed by this mode)"
  Say ""

  function Get-PackVersion([string]$file) {
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    $zip = [IO.Compression.ZipFile]::OpenRead($file)
    try {
      $entry = $zip.Entries | Where-Object { $_.FullName -eq "manifest.json" } | Select-Object -First 1
      if (-not $entry) { return $null }
      $reader = New-Object IO.StreamReader($entry.Open())
      try { $m = $reader.ReadToEnd() | ConvertFrom-Json } finally { $reader.Close() }
      return ($m.header.version -join ".")
    } finally { $zip.Dispose() }
  }

  $carried = $null
  if ($PackPath -and (Test-Path $PackPath -PathType Leaf)) {
    try { $carried = Get-PackVersion $PackPath } catch { $carried = $null }
  }
  Say ("  Build this file carries: " + $(if ($carried) { "v" + $carried } else { "unknown" }))
  Say ""

  $installed = @()
  foreach ($r in $roots) {
    foreach ($kind in @("behavior_packs", "development_behavior_packs")) {
      $dir = Join-Path $r $kind
      if (-not (Test-Path $dir)) { continue }
      foreach ($packDir in (Get-ChildItem $dir -Directory -ErrorAction SilentlyContinue)) {
        $mf = Join-Path $packDir.FullName "manifest.json"
        if (-not (Test-Path $mf)) { continue }
        try {
          $j = Get-Content $mf -Raw | ConvertFrom-Json
          if ($packUuids -contains $j.header.uuid) {
            $installed += [pscustomobject]@{ Ver = ($j.header.version -join "."); Path = $packDir.FullName }
          }
        } catch { }
      }
    }
  }
  Say "  Installed copies of the pack on disk:"
  if ($installed.Count -eq 0) { Say "    none - the pack is not installed on this PC at all" }
  foreach ($p in $installed) { Say ("    v" + $p.Ver + "   " + $p.Path) }
  Say ""

  # Separate pack, separate failure: a world can run the newest scoreboard and
  # still have no HUD pack, which on screen is "the pack does nothing".
  $hudInstalled = @()
  foreach ($r in $roots) {
    $dir = Join-Path $r "resource_packs"
    if (-not (Test-Path $dir)) { continue }
    foreach ($packDir in (Get-ChildItem $dir -Directory -ErrorAction SilentlyContinue)) {
      $mf = Join-Path $packDir.FullName "manifest.json"
      if (-not (Test-Path $mf)) { continue }
      try {
        $j = Get-Content $mf -Raw | ConvertFrom-Json
        if ($hudUuids -contains $j.header.uuid) {
          $hudInstalled += [pscustomobject]@{ Ver = ($j.header.version -join "."); Path = $packDir.FullName }
        }
      } catch { }
    }
  }
  Say "  RAB Personal HUD (optional resource pack):"
  if ($hudInstalled.Count -eq 0) {
    Say "    not installed on this PC - the per-player line stays above the hotbar"
  }
  foreach ($p in $hudInstalled) { Say ("    v" + $p.Ver + "   " + $p.Path) }
  Say ""

  $bound = 0
  $stale = @()
  Say "  Worlds and the build each is bound to:"
  foreach ($r in $roots) {
    $worlds = Join-Path $r "minecraftWorlds"
    if (-not (Test-Path $worlds)) { continue }
    foreach ($w in (Get-ChildItem $worlds -Directory -ErrorAction SilentlyContinue)) {
      $name = "(unnamed)"
      $lf = Join-Path $w.FullName "levelname.txt"
      if (Test-Path $lf) {
        $name = ((Get-Content $lf -Raw) -replace "\r?\n", "").Trim()
        if (-not $name) { $name = "(unnamed)" }
      }
      $wbp = Join-Path $w.FullName "world_behavior_packs.json"
      if (Test-Path $wbp) {
        try {
          $arr = Get-Content $wbp -Raw | ConvertFrom-Json
          foreach ($e in @($arr)) {
            if ($packUuids -notcontains $e.pack_id) { continue }
            $v = ($e.version -join ".")
            $bound++
            Say ("    " + $name + "  ->  bound to v" + $v)
            if ($carried -and $v -ne $carried) { $stale += $name }
          }
        } catch { Say ("    " + $name + "  ->  world_behavior_packs.json is unreadable") }
      }
      $wrp = Join-Path $w.FullName "world_resource_packs.json"
      if (Test-Path $wrp) {
        try {
          foreach ($e in (Get-Content $wrp -Raw | ConvertFrom-Json)) {
            if ($hudUuids -contains $e.pack_id) {
              Say ("    " + $name + "  ->  HUD pack applied (v" + ($e.version -join ".") + ")")
            }
          }
        } catch { }
      }
      $emb = Join-Path $w.FullName "behavior_packs"
      if (Test-Path $emb) {
        foreach ($inner in (Get-ChildItem $emb -Directory -ErrorAction SilentlyContinue)) {
          $mf = Join-Path $inner.FullName "manifest.json"
          if (-not (Test-Path $mf)) { continue }
          try {
            $j = Get-Content $mf -Raw | ConvertFrom-Json
            if ($packUuids -contains $j.header.uuid) {
              Say ("    " + $name + "  ->  EMBEDDED copy v" + ($j.header.version -join ".") + "  (this one wins over the installed copy)")
              if ($carried -and ($j.header.version -join ".") -ne $carried) { $stale += $name }
            }
          } catch { }
        }
      }
    }
  }
  if ($bound -eq 0) { Say "    no world on this PC has the pack applied" }
  Say ""

  Say "  What this means:"
  # A world can be stale twice over - bound to an old version AND carrying an
  # embedded copy of it - and naming it twice in one sentence reads like a bug.
  $stale = @($stale | Select-Object -Unique)
  if ($stale.Count -gt 0) {
    Say ("    " + ($stale -join ", ") + "  is/are on an older build than this file carries.")
    Say "    Run this file again WITHOUT /report to install and re-bind them."
  } elseif ($carried -and $bound -gt 0) {
    Say "    Every world here is bound to the build this file carries (v" + $carried + ")."
    Say "    If the world is a REALM, that is not enough - see the note below."
  }
  Say ""
  Say "  A REALM is a different story, and this is the usual reason a fix"
  Say "  does not show up in game:"
  Say "    the realm keeps its own copy of the pack on Microsoft's servers."
  Say "    Installing on this PC only makes the new build AVAILABLE. The"
  Say "    realm keeps running the build it was saved with until the realm"
  Say "    owner re-applies it:"
  Say "      Realm settings (the gear) -> World settings (the pencil) ->"
  Say "      Behavior packs -> untick RAB Scoreboard -> tick it again -> Save"
  if ($hudInstalled.Count -gt 0) {
    Say "      On that same screen: Resource packs -> tick RAB Personal HUD -> Save"
  }
  Say "    Then close the realm with the back arrow (that uploads it) and"
  Say "    reopen it. Only the realm's owner account can do this."
  Say ""
  Say "  To confirm which build is really running, join and open the RAB"
  Say "  RAB Manager (echo shard): the bottom line of the menu reads the build,"
  Say "  and the chat prints it on your first spawn."
  Say ""
  Clear-Temp
  exit 0
}

# -------------------------------------------------------------- 3. The build
Say "  [3/5] Choosing the build to install"
$dirs = @()
foreach ($d in @($RunDir, $PSScriptRoot, (Get-Location).Path)) {
  if ($d -and (Test-Path $d)) { $dirs += (Resolve-Path $d).Path }
}
$dirs = @($dirs | Select-Object -Unique)

$packCandidates = @()
if ($PackPath) {
  if (Test-Path $PackPath -PathType Container) {
    $packCandidates += (Join-Path $PackPath "RAB-Scoreboard.mcpack")
    $packCandidates += @(Get-ChildItem $PackPath -File -ErrorAction SilentlyContinue |
                         Where-Object { $_.Extension -in @(".mcpack", ".zip") } |
                         ForEach-Object { $_.FullName })
  } else {
    $packCandidates += $PackPath
  }
}
foreach ($d in $dirs) {
  $packCandidates += @(
    (Join-Path $d "RAB-Scoreboard.mcpack"),
    (Join-Path $d "RAB-Scoreboard.zip"),
    (Join-Path $d "addons\RAB-Scoreboard.mcpack")
  )
  $parent = Split-Path $d -Parent
  if ($parent) { $packCandidates += (Join-Path $parent "addons\RAB-Scoreboard.mcpack") }
}

$packFile = $null
foreach ($c in $packCandidates) {
  if ($c -and (Test-Path $c -PathType Leaf)) { $packFile = (Resolve-Path $c).Path; break }
}

$builtFrom = $null
if (-not $packFile) {
  $srcDirs = @()
  foreach ($d in $dirs) {
    $srcDirs += (Join-Path $d "addons\rab-scoreboard")
    $srcDirs += (Join-Path $d "rab-scoreboard")
  }
  foreach ($s in @($srcDirs | Select-Object -Unique)) {
    if ($s -and (Test-Path (Join-Path $s "manifest.json"))) { $builtFrom = $s; break }
  }
  if ($builtFrom) {
    $zip = Join-Path $env:TEMP ("rab-build-" + [IO.Path]::GetRandomFileName() + ".zip")
    Compress-Archive -Path (Join-Path $builtFrom "*") -DestinationPath $zip -CompressionLevel Optimal
    $tempWork.Add($zip)
    $packFile = $zip
  }
}

if ($packFile) {
  $label = if ($builtFrom) { "built from " + $builtFrom } else { $packFile }
} else {
  $label = $packUrl
}

$work = $null
try {
  if ($packFile) {
    $work = Expand-PackFile $packFile
  } else {
    Say "        no local pack found - downloading from GitHub"
    $zip = Join-Path $env:TEMP ("rab-dl-" + [IO.Path]::GetRandomFileName() + ".zip")
    try {
      Invoke-WebRequest -Uri $packUrl -OutFile $zip -UseBasicParsing
    } catch {
      throw ("could not download the pack (" + $_.Exception.Message + ")")
    }
    $tempWork.Add($zip)
    $work = Expand-PackFile $zip
  }
} catch {
  Stop-Fail $_.Exception.Message
}
$tempWork.Add($work)

$manifest = Get-Content (Join-Path $work "manifest.json") -Raw | ConvertFrom-Json
if (-not $manifest.header -or -not $manifest.header.uuid) {
  Stop-Fail "the manifest.json in that build is not readable"
}
if ($packUuids -notcontains $manifest.header.uuid) {
  Stop-Fail ("that build is a different pack (uuid " + $manifest.header.uuid + "), not RAB Scoreboard")
}
$version = @($manifest.header.version)
$versionText = ($version -join ".")
Say ("        " + $manifest.header.name + "  (build " + $versionText + ")")
Say ("        " + $label)

# ------------------------------------------- 3a. Is there a newer build online?
# This .cmd carries the whole pack inside itself, so left to itself it can only
# ever install the build it was cut from - which is how a months-old download keeps
# reinstalling a months-old version, silently. It used to print OUT OF DATE at the
# very end, by which time the old pack was already installed and the person had
# moved on. So ask the site first, and install what the site has. Offline, or if
# the download is not the right pack, it falls back to its own copy rather than
# leaving the PC with nothing.
$carriedText = $versionText
$siteVersion = $null
$siteNewer = $false
$downloaded = $false
if (-not $NoUpdateCheck) {
  $siteVersion = Get-SiteVersion
  $siteNewer = [bool]($siteVersion -and (Test-NewerVersion $siteVersion $versionText))
}
if ($siteNewer) {
  Say ("        site has v" + $siteVersion + " - this file carries v" + $carriedText + ", downloading it")
  $dl = Join-Path $env:TEMP ("rab-dl-" + [IO.Path]::GetRandomFileName() + ".zip")
  try {
    Invoke-WebRequest -Uri ($packUrl + "?t=" + [DateTime]::UtcNow.Ticks) -OutFile $dl -UseBasicParsing -TimeoutSec 60
    $tempWork.Add($dl)
    $freshWork = Expand-PackFile $dl
    $freshManifest = Get-Content (Join-Path $freshWork "manifest.json") -Raw | ConvertFrom-Json
    if (-not $freshManifest.header -or ($packUuids -notcontains $freshManifest.header.uuid)) {
      throw "that download is not RAB Scoreboard"
    }
    $freshText = (@($freshManifest.header.version) -join ".")
    if (-not (Test-NewerVersion $freshText $carriedText)) {
      throw ("the download is v" + $freshText + ", no newer than this file")
    }
    $tempWork.Add($freshWork)
    $work = $freshWork
    $manifest = $freshManifest
    $version = @($freshManifest.header.version)
    $versionText = $freshText
    # Say where the build came from in the summary, not where the old copy was.
    $label = $packUrl
    $downloaded = $true
    Say ("        using v" + $versionText + " from the site instead of the copy inside this file")
  } catch {
    Say ("        could not fetch it: " + $_.Exception.Message)
    Say ("        installing the copy this file carries - v" + $carriedText)
  }
}

# ------------------------------------------------------- 3b. The HUD pack
# Optional, and deliberately not fatal: a missing or wrong HUD pack must never
# stop the scoreboard from installing. It is only ever added to worlds that
# already use the scoreboard, never forced on unrelated worlds.
$hudWork = $null
$hudVersion = $null
$hudVersionText = $null
$hudCandidates = @()
if ($HudPath) {
  if (Test-Path $HudPath -PathType Container) { $hudCandidates += (Join-Path $HudPath "RAB-HUD.mcpack") }
  else { $hudCandidates += $HudPath }
}
foreach ($d in $dirs) {
  $hudCandidates += @(
    (Join-Path $d "RAB-HUD.mcpack"),
    (Join-Path $d "RAB-HUD.zip"),
    (Join-Path $d "addons\RAB-HUD.mcpack")
  )
  $parent = Split-Path $d -Parent
  if ($parent) { $hudCandidates += (Join-Path $parent "addons\RAB-HUD.mcpack") }
}
# A downloaded pack usually lands in Downloads and never gets moved next to this
# file - looking there too turns "the pack does nothing" into a working install.
foreach ($loose in @((Join-Path $env:USERPROFILE "Downloads"), (Join-Path $env:USERPROFILE "Desktop"))) {
  if ($loose) { $hudCandidates += (Join-Path $loose "RAB-HUD.mcpack") }
}
$hudFile = $null
foreach ($c in $hudCandidates) {
  if ($c -and (Test-Path $c -PathType Leaf)) { $hudFile = (Resolve-Path $c).Path; break }
}
if ($hudFile) {
  try {
    $candidate = Expand-PackFile $hudFile
    $tempWork.Add($candidate)
    $hudManifest = Get-Content (Join-Path $candidate "manifest.json") -Raw | ConvertFrom-Json
    if (-not $hudManifest.header -or ($hudUuids -notcontains $hudManifest.header.uuid)) {
      Say ("        " + (Split-Path $hudFile -Leaf) + " is not the RAB HUD pack - ignored")
    } else {
      $hudWork = $candidate
      $hudVersion = @($hudManifest.header.version)
      $hudVersionText = ($hudVersion -join ".")
      Say ("        HUD: " + $hudManifest.header.name + "  (build " + $hudVersionText + ")")
    }
  } catch {
    Say ("        HUD pack ignored: " + $_.Exception.Message)
  }
} else {
  Say "        HUD: no RAB-HUD.mcpack found - scoreboard only"
}

# --------------------------------------------------------------- 4. Install
Say "  [4/5] Installing"
$installInto = @()
foreach ($r in $roots) {
  $hadOld = $false
  foreach ($kind in @("behavior_packs", "development_behavior_packs")) {
    $dir = Join-Path $r $kind
    if (-not (Test-Path $dir)) { continue }
    foreach ($packDir in (Get-ChildItem $dir -Directory -ErrorAction SilentlyContinue)) {
      $mf = Join-Path $packDir.FullName "manifest.json"
      if (-not (Test-Path $mf)) { continue }
      try {
        $old = Get-Content $mf -Raw | ConvertFrom-Json
        if ($packUuids -contains $old.header.uuid) {
          Remove-Item $packDir.FullName -Recurse -Force -ErrorAction SilentlyContinue
          if (Test-Path $packDir.FullName) {
            Say ("        could not remove " + $kind + "\" + $packDir.Name + " (in use)")
          } else {
            Say ("        removed " + $kind + "\" + $packDir.Name + "  (v" + ($old.header.version -join ".") + ")")
          }
          $hadOld = $true
        }
      } catch { }
    }
  }
  if ($hadOld) { $installInto += $r }
}

if ($installInto.Count -eq 0) {
  $shared = $roots | Where-Object { $_ -like "*\Shared\*" } | Select-Object -First 1
  if ($shared) {
    $installInto = @($shared)
  } else {
    $withWorlds = @()
    foreach ($r in $roots) {
      $w = Join-Path $r "minecraftWorlds"
      if ((Test-Path $w) -and (@(Get-ChildItem $w -Directory -ErrorAction SilentlyContinue).Count -gt 0)) {
        $withWorlds += $r
      }
    }
    if ($withWorlds.Count -gt 0) { $installInto = @($withWorlds[0]) } else { $installInto = @($roots[0]) }
  }
  Say "        no old copy found - fresh install"
}

foreach ($t in $installInto) {
  $bp = Join-Path $t "behavior_packs"
  $dest = Join-Path $bp $packFolder
  New-Item -ItemType Directory -Force -Path $bp | Out-Null
  if (Test-Path $dest) { Remove-Item $dest -Recurse -Force -ErrorAction SilentlyContinue }
  New-Item -ItemType Directory -Force -Path $dest | Out-Null
  try {
    Copy-Item (Join-Path $work "*") $dest -Recurse -Force
  } catch {
    Stop-Fail ("could not write " + $dest + " (" + $_.Exception.Message + ")")
  }
  if (-not (Test-Path (Join-Path $dest "manifest.json"))) {
    Stop-Fail ("install did not complete in " + $dest)
  }
  $icon = if (Test-Path (Join-Path $dest "pack_icon.png")) { "yes" } else { "no" }
  Say ("        installed -> " + $dest)
  Say ("                     (icon: " + $icon + ")")

  if ($hudWork) {
    $rp = Join-Path $t "resource_packs"
    New-Item -ItemType Directory -Force -Path $rp | Out-Null
    # drop any older copy of the same pack, whatever folder it was imported into
    foreach ($packDir in (Get-ChildItem $rp -Directory -ErrorAction SilentlyContinue)) {
      $mf = Join-Path $packDir.FullName "manifest.json"
      if (-not (Test-Path $mf)) { continue }
      try {
        $old = Get-Content $mf -Raw | ConvertFrom-Json
        if ($hudUuids -contains $old.header.uuid) {
          Remove-Item $packDir.FullName -Recurse -Force -ErrorAction SilentlyContinue
        }
      } catch { }
    }
    $rdest = Join-Path $rp $hudFolder
    New-Item -ItemType Directory -Force -Path $rdest | Out-Null
    try {
      Copy-Item (Join-Path $hudWork "*") $rdest -Recurse -Force
    } catch {
      Say ("        HUD not installed: " + $_.Exception.Message)
    }
    if (Test-Path (Join-Path $rdest "manifest.json")) {
      Say ("        HUD installed -> " + $rdest)
    }
  }
}

# ------------------------------------------------------------ 5. Re-bind worlds
Say "  [5/5] Re-binding worlds"
$updated = 0
$current = 0
$cleared = 0
$hudApplied = 0

foreach ($r in $roots) {
  $worlds = Join-Path $r "minecraftWorlds"
  if (-not (Test-Path $worlds)) { continue }
  foreach ($w in (Get-ChildItem $worlds -Directory -ErrorAction SilentlyContinue)) {
    $name = "(unnamed)"
    $lf = Join-Path $w.FullName "levelname.txt"
    if (Test-Path $lf) {
      $name = ((Get-Content $lf -Raw) -replace "\r?\n", "").Trim()
      if (-not $name) { $name = "(unnamed)" }
    }

    # a copy stored inside the world folder shadows the installed one
    $emb = Join-Path $w.FullName "behavior_packs"
    if (Test-Path $emb) {
      foreach ($inner in (Get-ChildItem $emb -Directory -ErrorAction SilentlyContinue)) {
        $mf = Join-Path $inner.FullName "manifest.json"
        if (-not (Test-Path $mf)) { continue }
        try {
          $j = Get-Content $mf -Raw | ConvertFrom-Json
          if ($packUuids -contains $j.header.uuid) {
            Remove-Item $inner.FullName -Recurse -Force -ErrorAction SilentlyContinue
            Say ("        cleared old copy embedded in world '" + $name + "'")
            $cleared++
          }
        } catch { }
      }
    }

    $wbp = Join-Path $w.FullName "world_behavior_packs.json"
    if (-not (Test-Path $wbp)) { continue }
    try {
      $parsed = Get-Content $wbp -Raw | ConvertFrom-Json
    } catch {
      Say ("        could not read " + $wbp)
      continue
    }
    # ConvertFrom-Json hands back the array as a single object, so copy the
    # elements out by hand - otherwise the entries below are one big array.
    $entries = @()
    foreach ($x in $parsed) { $entries += $x }

    $changed = $false
    $already = $false
    $usesPack = $false
    foreach ($e in $entries) {
      if ($packUuids -contains $e.pack_id) {
        $usesPack = $true
        if (($e.version -join ".") -eq $versionText) { $already = $true }
        else { $e.version = $version; $changed = $true }
      }
    }

    if ($changed) {
      Copy-Item $wbp ($wbp + ".bak") -Force -ErrorAction SilentlyContinue
      $json = ConvertTo-Json -InputObject @($entries) -Depth 5
      [IO.File]::WriteAllText($wbp, $json, (New-Object System.Text.UTF8Encoding($false)))
      Say ("        updated world '" + $name + "' -> v" + $versionText)
      $updated++
    } elseif ($already) {
      $current++
    }

    # The HUD pack is a resource pack, so it is bound in a different file. Only
    # worlds that already run the scoreboard get it: a world that has never
    # heard of RAB should not have its action bar moved behind the owner's back.
    if ($hudWork -and $usesPack) {
      $wrp = Join-Path $w.FullName "world_resource_packs.json"
      $rEntries = @()
      if (Test-Path $wrp) {
        try {
          $rParsed = Get-Content $wrp -Raw | ConvertFrom-Json
          foreach ($x in $rParsed) { $rEntries += $x }
        } catch {
          Say ("        could not read " + $wrp)
          $rEntries = $null
        }
      }
      if ($null -ne $rEntries) {
        $rChanged = $false
        $rFound = $false
        foreach ($e in $rEntries) {
          if ($hudUuids -contains $e.pack_id) {
            $rFound = $true
            if (($e.version -join ".") -ne $hudVersionText) { $e.version = $hudVersion; $rChanged = $true }
          }
        }
        if (-not $rFound) {
          $rEntries += [pscustomobject]@{ pack_id = $hudUuids[0]; version = $hudVersion }
          $rChanged = $true
        }
        if ($rChanged) {
          if (Test-Path $wrp) { Copy-Item $wrp ($wrp + ".bak") -Force -ErrorAction SilentlyContinue }
          $json = ConvertTo-Json -InputObject @($rEntries) -Depth 5
          [IO.File]::WriteAllText($wrp, $json, (New-Object System.Text.UTF8Encoding($false)))
          Say ("        applied HUD pack to world '" + $name + "'")
          $hudApplied++
        }
      }
    }
  }
}

if ($updated -eq 0 -and $current -eq 0 -and $cleared -eq 0) {
  Say "        no world uses the pack yet - nothing to re-bind"
} elseif ($updated -eq 0 -and $current -gt 0) {
  Say "        every world is already on v$versionText"
}

# ------------------------------------------------------------------ summary
Say ""
Say ("  DONE - RAB Scoreboard v" + $versionText)
Say ("    build   : " + $label)
foreach ($t in $installInto) { Say ("    install : " + (Join-Path $t ("behavior_packs\" + $packFolder))) }
$worldLine = "$updated updated, $current already current"
if ($cleared -gt 0) { $worldLine += ", $cleared embedded copy cleared" }
Say ("    worlds  : " + $worldLine)
if ($hudVersionText) {
  foreach ($t in $installInto) { Say ("    HUD     : v" + $hudVersionText + "  " + (Join-Path $t ("resource_packs\" + $hudFolder))) }
  Say ("    HUD in  : " + $hudApplied + " world(s) applied")
} else {
  Say "    HUD     : not installed (drop RAB-HUD.mcpack next to this file or in Downloads)"
}
Say ""
Say "  Open Minecraft and play - the pack stays enabled in your worlds."

# ---------------------------------------------------------- what was installed
# Everything above already decided which build to install, so this only says
# which one that was. A stale download is still visible here, and if the site
# could not be reached at all it says nothing rather than guessing.
if (-not $NoUpdateCheck -and $siteVersion) {
  Say ""
  if ($downloaded) {
    Say ("  Installed v" + $versionText + " - the newest build - straight from the site.")
    Say ("  This file itself carries v" + $carriedText + " - download the current")
    Say  "  RAB-Update.cmd from the site when convenient, so the file matches too."
  } elseif ($siteNewer) {
    Say  "  ==============================================================="
    Say ("   OUT OF DATE: this file carries v" + $carriedText + ", the site has v" + $siteVersion + ".")
    Say  "   The download failed, so the older build was installed."
    Say  "   Download the current RAB-Update.cmd from the site and run that."
    Say  "  ==============================================================="
  } elseif ($siteVersion -ne $versionText) {
    Say ("  The site has v" + $siteVersion + ", older than this file's v" + $carriedText + ".")
    Say  "  This file's copy was installed."
  } else {
    Say ("  This is the newest build (v" + $siteVersion + ").")
  }
}

Clear-Temp
exit 0
