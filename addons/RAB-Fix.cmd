@echo off
title RAB Fix v2
echo ================================================================
echo   RAB Fix v2 - unbinds the RAB Scoreboard from every world,
echo   deletes every copy, installs the current build fresh.
echo   Run with Minecraft fully closed.
echo ================================================================
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$uuid='efb65a54-925f-4010-81df-94f716666141'; $mc=Get-Process -Name 'Minecraft.Windows' -ErrorAction SilentlyContinue; if($mc){ Write-Host '  Minecraft is RUNNING. Close it completely, then run this again.'; exit 1 }; $roots=@(\"$env:LocalAppData\Packages\Microsoft.MinecraftUWP_8wekyb3d8bbwe\LocalState\games\com.mojang\",\"$env:LocalAppData\Packages\Microsoft.MinecraftWindowsBeta_8wekyb3d8bbwe\LocalState\games\com.mojang\",\"$env:LocalAppData\games\com.mojang\"); $live=@(); foreach($r in $roots){ if(Test-Path $r){ $live+=$r; Write-Host ('  Minecraft data folder: ' + $r) } }; if(-not $live.Count){ Write-Host '  No Minecraft data folder found - is Bedrock installed on this PC?'; exit 1 }; Write-Host ''; Write-Host '  STEP 1 - worlds that reference the pack:'; $any=$false; foreach($r in $live){ $wdir=Join-Path $r 'minecraftWorlds'; if(-not (Test-Path $wdir)){ continue }; Get-ChildItem $wdir -Directory -ErrorAction SilentlyContinue | ForEach-Object { $wname='(unnamed)'; $lf=Join-Path $_.FullName 'levelname.txt'; if(Test-Path $lf){ $wname=(Get-Content $lf -Raw).Trim() }; $wbp=Join-Path $_.FullName 'world_behavior_packs.json'; if(Test-Path $wbp){ try { $arr=Get-Content $wbp -Raw | ConvertFrom-Json; $hits=@($arr | Where-Object { $_.pack_id -eq $uuid }); if($hits.Count -gt 0){ $script:any=$true; foreach($h in $hits){ Write-Host ('    unbinding ' + $wname + '  (was v' + ($h.version -join '.') + ')') }; Copy-Item $wbp ($wbp + '.bak') -Force; $rest=@($arr | Where-Object { $_.pack_id -ne $uuid }); if($rest.Count -eq 0){ Set-Content -Path $wbp -Value '[]' } else { ConvertTo-Json -InputObject $rest -Depth 5 | Set-Content -Path $wbp } } } catch { Write-Host ('    could not read ' + $wbp) } }; $emb=Join-Path $_.FullName 'behavior_packs'; if(Test-Path $emb){ Get-ChildItem $emb -Directory -ErrorAction SilentlyContinue | ForEach-Object { $mf2=Join-Path $_.FullName 'manifest.json'; if(Test-Path $mf2){ try { $jj=Get-Content $mf2 -Raw | ConvertFrom-Json; if($jj.header.uuid -eq $uuid){ $script:any=$true; Remove-Item $_.FullName -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ('    removed embedded copy inside world ' + $wname + ' (was v' + ($jj.header.version -join '.') + ')') } } catch {} } } } } }; if(-not $any){ Write-Host '    none - the world does not reference it' }; Write-Host ''; Write-Host '  STEP 2 - copies on disk:'; $found=@(); foreach($r in $live){ foreach($kind in @('behavior_packs','development_behavior_packs')){ $dir=Join-Path $r $kind; if(-not (Test-Path $dir)){ continue }; Get-ChildItem $dir -Directory -ErrorAction SilentlyContinue | ForEach-Object { $mf=Join-Path $_.FullName 'manifest.json'; if(Test-Path $mf){ try { $j=Get-Content $mf -Raw | ConvertFrom-Json; if($j.header.uuid -eq $uuid){ $found+=[pscustomobject]@{Path=$_.FullName; Ver=($j.header.version -join '.')} } } catch {} } } } }; if($found.Count -eq 0){ Write-Host '    none' } else { foreach($f in $found){ Write-Host ('    v' + $f.Ver + '   ' + $f.Path) }; foreach($f in $found){ Remove-Item $f.Path -Recurse -Force -ErrorAction SilentlyContinue; if(Test-Path $f.Path){ Write-Host ('    COULD NOT DELETE: ' + $f.Path) } else { Write-Host ('    deleted: ' + $f.Path) } } }; Write-Host ''; Write-Host '  STEP 3 - installing the current build:'; foreach($r in $live){ $bp=Join-Path $r 'behavior_packs'; try { $z=Join-Path $env:TEMP ('rab-'+[IO.Path]::GetRandomFileName()+'.zip'); Invoke-WebRequest -Uri 'https://sherowhayden-maker.github.io/addons/RAB-Scoreboard.mcpack' -OutFile $z -UseBasicParsing; $x=Join-Path $env:TEMP ('rab-x-'+[IO.Path]::GetRandomFileName()); Expand-Archive -LiteralPath $z -DestinationPath $x -Force; if(-not (Test-Path (Join-Path $x 'manifest.json'))){ throw 'download was not a valid pack' }; New-Item -ItemType Directory -Force -Path $bp | Out-Null; $dest=Join-Path $bp 'RAB-Scoreboard'; if(Test-Path $dest){ Remove-Item $dest -Recurse -Force }; New-Item -ItemType Directory -Force -Path $dest | Out-Null; Copy-Item (Join-Path $x '*') $dest -Recurse -Force; $m=Get-Content (Join-Path $x 'manifest.json') -Raw | ConvertFrom-Json; $hasIcon=Test-Path (Join-Path $dest 'pack_icon.png'); Write-Host ('    INSTALLED v' + ($m.header.version -join '.') + '   icon: ' + $(if($hasIcon){'yes'}else{'NO'})); Write-Host ('    ' + $dest); Remove-Item $x -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item $z -Force -ErrorAction SilentlyContinue } catch { Write-Host ('    INSTALL FAILED: ' + $_.Exception.Message); exit 1 } }; Write-Host ''; Write-Host '  DONE. Open Minecraft, Edit World, Behavior Packs.'; Write-Host '  You should now see exactly ONE RAB Scoreboard, WITH a'; Write-Host '  gold star icon. Activate it, then Play.'"
echo.
pause
