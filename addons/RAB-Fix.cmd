@echo off
title RAB Fix v4
echo ================================================================
echo   RAB Fix v4 - unbinds the RAB pack from every world, deletes
echo   every copy in every Minecraft data folder, installs the
echo   current build. Run with Minecraft closed.
echo ================================================================
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$uuids=@('efb65a54-925f-4010-81df-94f716666141','f293a3f3-67f8-44ba-ac2f-faa727532237'); $mc=Get-Process -Name 'Minecraft.Windows' -ErrorAction SilentlyContinue; if($mc){ Write-Host '  Minecraft is RUNNING. Close it completely, then run this again.'; exit 1 }; $roots=@(); foreach($l in @(\"$env:LocalAppData\Packages\Microsoft.MinecraftUWP_8wekyb3d8bbwe\LocalState\games\com.mojang\",\"$env:LocalAppData\Packages\Microsoft.MinecraftWindowsBeta_8wekyb3d8bbwe\LocalState\games\com.mojang\",\"$env:LocalAppData\games\com.mojang\")){ if(Test-Path $l){ $roots += $l } }; $lb=Join-Path $env:AppData 'Minecraft Bedrock\Users'; if(Test-Path $lb){ Get-ChildItem $lb -Directory -ErrorAction SilentlyContinue | ForEach-Object { $p=Join-Path $_.FullName 'games\com.mojang'; if(Test-Path $p){ $roots += $p } } }; $roots=@($roots | Select-Object -Unique); if(-not $roots.Count){ Write-Host '  FAILED: no Minecraft data folder found'; exit 1 }; Write-Host '  Data folders found:'; foreach($r in $roots){ Write-Host ('    ' + $r) }; Write-Host ''; Write-Host '  STEP 1 - worlds that reference the pack:'; $any=$false; foreach($r in $roots){ $wdir=Join-Path $r 'minecraftWorlds'; if(-not (Test-Path $wdir)){ continue }; Get-ChildItem $wdir -Directory -ErrorAction SilentlyContinue | ForEach-Object { $wname='(unnamed)'; $lf=Join-Path $_.FullName 'levelname.txt'; if(Test-Path $lf){ $wname=(Get-Content $lf -Raw).Trim() }; $wbp=Join-Path $_.FullName 'world_behavior_packs.json'; if(Test-Path $wbp){ try { $arr=Get-Content $wbp -Raw | ConvertFrom-Json; $hits=@($arr | Where-Object { $uuids -contains $_.pack_id }); if($hits.Count -gt 0){ $script:any=$true; foreach($h in $hits){ Write-Host ('    unbinding ' + $wname + '  (was v' + ($h.version -join '.') + ')') }; Copy-Item $wbp ($wbp + '.bak') -Force; $rest=@($arr | Where-Object { $uuids -notcontains $_.pack_id }); if($rest.Count -eq 0){ Set-Content -Path $wbp -Value '[]' } else { ConvertTo-Json -InputObject $rest -Depth 5 | Set-Content -Path $wbp } } } catch { Write-Host ('    could not read ' + $wbp) } }; $emb=Join-Path $_.FullName 'behavior_packs'; if(Test-Path $emb){ Get-ChildItem $emb -Directory -ErrorAction SilentlyContinue | ForEach-Object { $mf2=Join-Path $_.FullName 'manifest.json'; if(Test-Path $mf2){ try { $jj=Get-Content $mf2 -Raw | ConvertFrom-Json; if($uuids -contains $jj.header.uuid){ $script:any=$true; Remove-Item $_.FullName -Recurse -Force -ErrorAction SilentlyContinue; Write-Host ('    removed embedded copy inside world ' + $wname + ' (was v' + ($jj.header.version -join '.') + ')') } } catch {} } } } } }; if(-not $any){ Write-Host '    none' }; Write-Host ''; Write-Host '  STEP 2 - copies on disk:'; $targets=@(); foreach($r in $roots){ Write-Host ('    in ' + $r); $hitsHere=0; foreach($kind in @('behavior_packs','development_behavior_packs')){ $dir=Join-Path $r $kind; if(-not (Test-Path $dir)){ continue }; Get-ChildItem $dir -Directory -ErrorAction SilentlyContinue | ForEach-Object { $mf=Join-Path $_.FullName 'manifest.json'; if(Test-Path $mf){ try { $j=Get-Content $mf -Raw | ConvertFrom-Json; if($uuids -contains $j.header.uuid){ $script:hitsHere++; $script:targets += $r; Write-Host ('      v' + ($j.header.version -join '.') + '  ' + $kind + '\' + $_.Name); Remove-Item $_.FullName -Recurse -Force -ErrorAction SilentlyContinue } } catch {} } } }; if($hitsHere -eq 0){ Write-Host '      (none)' } }; $targets=@($targets | Select-Object -Unique); if(-not $targets.Count){ $shared=$roots | Where-Object { $_ -like '*\Shared\*' } | Select-Object -First 1; if($shared){ $targets=@($shared) } else { $targets=@($roots[0]) } }; Write-Host ''; Write-Host '  STEP 3 - installing:'; foreach($t in $targets){ $bp=Join-Path $t 'behavior_packs'; try { $z=Join-Path $env:TEMP ('rab-'+[IO.Path]::GetRandomFileName()+'.zip'); Invoke-WebRequest -Uri 'https://sherowhayden-maker.github.io/addons/RAB-Scoreboard.mcpack' -OutFile $z -UseBasicParsing; $x=Join-Path $env:TEMP ('rab-x-'+[IO.Path]::GetRandomFileName()); Expand-Archive -LiteralPath $z -DestinationPath $x -Force; if(-not (Test-Path (Join-Path $x 'manifest.json'))){ throw 'download was not a valid pack' }; New-Item -ItemType Directory -Force -Path $bp | Out-Null; $dest=Join-Path $bp 'RAB-Scoreboard'; if(Test-Path $dest){ Remove-Item $dest -Recurse -Force }; New-Item -ItemType Directory -Force -Path $dest | Out-Null; Copy-Item (Join-Path $x '*') $dest -Recurse -Force; $m=Get-Content (Join-Path $x 'manifest.json') -Raw | ConvertFrom-Json; $hasIcon=Test-Path (Join-Path $dest 'pack_icon.png'); Write-Host ('    INSTALLED ' + $m.header.name + ' v' + ($m.header.version -join '.') + '   icon: ' + $(if($hasIcon){'yes'}else{'NO'})); Write-Host ('    ' + $dest); Remove-Item $x -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item $z -Force -ErrorAction SilentlyContinue } catch { Write-Host ('    INSTALL FAILED: ' + $_.Exception.Message); exit 1 } }; Write-Host ''; Write-Host '  DONE. Open Minecraft, Edit World, Behavior Packs,'; Write-Host '  activate RAB Scoreboard v2 (gold star), Play.'"
echo.
pause
